# Copy to .env and fill in real values. Never commit .env.

# ── Gemini (Google AI Studio) ────────────────────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_AGENT_MODEL=gemini-2.5-flash
GEMINI_SYNTHESIS_MODEL=gemini-2.5-pro

# ── Firebase ─────────────────────────────────────────────────
# Create project at https://console.firebase.google.com
# Generate a service account: Project Settings → Service Accounts → Generate new private key
# Save the JSON to backend/firebase-credentials.json (gitignored)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_PROJECT_ID=

# ── Google Maps ──────────────────────────────────────────────
# https://console.cloud.google.com/google/maps-apis
# Enable: Places API, Maps JavaScript API
GOOGLE_MAPS_API_KEY=

# ── Local data ───────────────────────────────────────────────
DRAP_SQLITE_PATH=./data_store/drap.sqlite

# ── Server ───────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Agent behavior ───────────────────────────────────────────
AGENT_MAX_TOOL_CALLS=15
AGENT_TIMEOUT_SECONDS=30
