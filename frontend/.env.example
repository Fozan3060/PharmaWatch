# Backend API base URL (omit to use the Vite dev proxy at /agent, /reports, etc.)
VITE_API_BASE_URL=

# Google Maps JavaScript API key (Places + Maps JavaScript enabled)
# https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Web SDK config (Project Settings -> Your apps -> Web app)
# These values are public and safe to commit to a build, but kept in .env
# for environment-driven config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
